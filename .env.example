# 生产档 compose 所需环境变量（复制为 .env 后再起服）
RELAY_DOMAIN=relay.example.com
RELAY_JWT_SECRET=change-me-to-a-random-string-of-at-least-32-bytes
PG_USER=relay
PG_PASSWORD=change-me
PG_DB=relay

# 可选
RELAY_POW_DIFFICULTY=4
RELAY_REGISTER_LIMIT_PER_MIN=3
RELAY_FRIEND_INVITE_LIMIT_PER_MIN=10
BACKUP_RETAIN_DAYS=7
# 异地备份（容器内需有 rclone 并已配置远端）；留空则只本地留存
RCLONE_REMOTE=
