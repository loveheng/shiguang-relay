# 生产档 compose 所需环境变量（复制为 .env 后再起服）
# relay 服务镜像：默认拉取 GHCR 上自动构建的镜像，可按需锁定到具体 tag（如 :v1.0.0）
RELAY_IMAGE=ghcr.io/loveheng/shiguang-relay:latest
RELAY_DOMAIN=relay.example.com
RELAY_JWT_SECRET=change-me-to-a-random-string-of-at-least-32-bytes
PG_USER=relay
PG_PASSWORD=change-me
PG_DB=relay

# 可选
RELAY_POW_DIFFICULTY=4
RELAY_REGISTER_LIMIT_PER_MIN=3
RELAY_FRIEND_INVITE_LIMIT_PER_MIN=10
# 登录防爆破：单 IP 每分钟尝试上限 / 单账号失败锁定阈值与窗口
RELAY_LOGIN_LIMIT_PER_MIN=10
RELAY_LOGIN_MAX_FAILS=5
RELAY_LOGIN_LOCK_WINDOW_SEC=900
BACKUP_RETAIN_DAYS=7
# relay 监听地址与 Redis 地址（一般无需改）
RELAY_LISTEN=:8080
RELAY_REDIS_ADDR=redis:6379
# 异地备份（容器内需有 rclone 并已配置远端）；留空则只本地留存
RCLONE_REMOTE=
